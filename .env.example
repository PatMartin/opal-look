# OPAL Look environment / .env template.
# Loaded at service startup (python-dotenv); real environment variables
# always win over values here — .env never overrides them. Gitignored.

# --- runtime ---
# Bind address and port (default 127.0.0.1:8002). Non-loopback binds
# require OPAL_LOOK_TOKEN.
#OPAL_LOOK_HOST=127.0.0.1
#OPAL_LOOK_PORT=8002

# Data directory (default ./data)
#OPAL_LOOK_DATA_DIR=data

# Bearer token. Set -> every /api/v1 request needs
# 'Authorization: Bearer <token>'. Unset -> loopback dev mode.
#OPAL_LOOK_TOKEN=change-me

# --- RTSP credentials ---
# Named "user:pass" pairs injected into camera URIs at connect time;
# never stored, logged, or echoed by the API.
#OPAL_LOOK_CRED_DRIVEWAY=user:password

# --- service settings (/api/v1/setting/ keys) ---
# Any documented setting key in uppercase. Read as an overlay on every
# read — takes precedence over persisted overrides (source reports
# "environment"/"dotenv"); never written to the database. Invalid
# values are skipped with a warning.
#OPAL_LOOK_MAX_CONCURRENT_STREAMS=4
#OPAL_LOOK_SSE_BUFFER_EVENTS=256
#OPAL_LOOK_SSE_REPLAY_SECONDS=60
#OPAL_LOOK_FRAME_CACHE_SECONDS=30
#OPAL_LOOK_MAX_UPLOAD_BYTES=1073741824
#OPAL_LOOK_MAX_IMAGE_PIXELS=50000000
#OPAL_LOOK_MAX_VIEWERS=8

# --- source policy (/api/v1/setting/ keys, JSON values) ---
# Sources are checked before any read/decode:
#   source_local_roots   local predict paths must resolve under one of
#                        these roots ([] = local file sources denied)
#   source_allowed_hosts permitted remote destinations: "name", "name:port",
#                        IP, or CIDR — wins over the private/reserved rules
#   source_allow_private true also permits RFC1918/ULA/loopback targets
#                        (link-local/multicast/reserved stay explicit-only)
#OPAL_LOOK_SOURCE_LOCAL_ROOTS=["D:/images"]
#OPAL_LOOK_SOURCE_ALLOWED_HOSTS=["192.168.1.220","192.168.1.0/24","cam.local:554"]
#OPAL_LOOK_SOURCE_ALLOW_PRIVATE=false

# --- remote inference engines ---
# OPAL_LOOK_ENGINE_<ID>_* declares and configures a remote adapter.
# Seeded into the engines table at startup; authoritative over
# PATCH /api/v1/engine/{id} (re-applied every boot). TOKEN is env-only —
# never written to the DB, logged, or echoed.
#
#   OPAL_LOOK_ENGINE_<ID>_BASE_URL        adapter service URL; presence
#                                       registers the engine
#   OPAL_LOOK_ENGINE_<ID>_ENABLED         true|false (default true)
#   OPAL_LOOK_ENGINE_<ID>_TIMEOUT_SECONDS per-request timeout (default 30)
#   OPAL_LOOK_ENGINE_<ID>_TOKEN           bearer token for the adapter
#
# Currently supported ids: yolo
#OPAL_LOOK_ENGINE_YOLO_BASE_URL=http://127.0.0.1:8086
#OPAL_LOOK_ENGINE_YOLO_ENABLED=true
#OPAL_LOOK_ENGINE_YOLO_TIMEOUT_SECONDS=30
#OPAL_LOOK_ENGINE_YOLO_TOKEN=
